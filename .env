*# SQLite 本地开发配置（无需外部数据库）
# 数据库文件会自动创建在: ./hospital.db

# 可视化/分析（本地开发默认关闭）
ANALYTICS_ENABLED=false

# 后端配置
SPRING_PROFILES_ACTIVE=
JWT_SECRET=change-me-to-a-256-bit-secret-string-in-production
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,http://localhost
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,http://localhost
JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# 初始管理员账户
INIT_ADMIN_ENABLED=true
INIT_ADMIN_EMAIL=admin@hospital.local
INIT_ADMIN_PASSWORD=Admin123!
INIT_ADMIN_FULL_NAME=System Admin

# 端口配置
BACKEND_PORT=9090
FRONTEND_PORT=80

# Coze API 配置（本地演示模式，不需要真实密钥）
COZE_API_KEY=
COZE_WORKFLOW_ID=
COZE_API_URL=http://localhost:8000/api/coze/chat
COZE_ENABLED=false

# LLM 大模型配置（火山方舟 Doubao）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=ark-7c5a1fda-aea0-4e24-9f28-1e0faf3e451b-67fb7
LLM_MODEL=ep-20260811021418-cxvdz
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# 时区
TZ=Asia/Shanghai
